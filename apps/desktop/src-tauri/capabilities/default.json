{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://guna81.github.io/mytowncart-billing/*"
        },
        {
          "url": "https://guna81.github.io/mytowncart-billing"
        },
        {
          "url": "https://github.com/guna81/mytowncart-billing/releases/*"
        },
        { "url": "https://mytowncart.com/*" },
        { "url": "https://api.mytowncart.com/*" },
        { "url": "https://mytowncart.in/*" },
        { "url": "https://api.mytowncart.in/*" }
      ]
    }
  ]
}
