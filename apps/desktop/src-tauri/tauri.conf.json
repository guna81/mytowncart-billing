{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTownCart Billing",
  "version": "0.1.4",
  "identifier": "com.mytowncart.billing",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @mytowncart-billing/web dev",
    "beforeBuildCommand": "pnpm --filter @mytowncart-billing/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyTownCart Billing",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://mytowncart.com https://api.mytowncart.com https://mytowncart.in https://api.mytowncart.in https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
